{
  "name": "@jasy/react",
  "version": "1.0.0-beta.2",
  "description": "Author PDFs as React components - layout, pagination, fonts, forms - rendered in the browser or on a server. A thin React renderer over @jasy/pdf.",
  "keywords": [
    "browser",
    "declarative",
    "invoice",
    "jasy",
    "jsx",
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "react",
    "renderer"
  ],
  "license": "MIT",
  "author": "Florian Heuberger",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "play": "vite playground --open",
    "test": "vitest run"
  },
  "dependencies": {
    "react-reconciler": "^0.31.0"
  },
  "devDependencies": {
    "@jasy/pdf": "workspace:*",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.4"
  },
  "peerDependencies": {
    "@jasy/pdf": "workspace:^",
    "react": "^19.0.0"
  }
}
