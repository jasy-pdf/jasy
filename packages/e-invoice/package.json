{
  "name": "@jasy/e-invoice",
  "version": "1.0.0-beta.3",
  "description": "ZUGFeRD, XRechnung and Factur-X e-invoices in TypeScript / Node.js: EN 16931 CII or UBL XML and PDF/A-3 from one typed invoice object, tested against the KoSIT rules and veraPDF.",
  "keywords": [
    "cii",
    "e-invoice",
    "e-rechnung",
    "einvoice",
    "en16931",
    "erechnung",
    "factur-x",
    "invoice",
    "invoice-generator",
    "kosit",
    "nodejs",
    "pdf-a",
    "typescript",
    "ubl",
    "xrechnung",
    "zugferd"
  ],
  "license": "MIT",
  "author": "Florian Heuberger",
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-dts-ext.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "validate": "tsc && node scripts/validate.mjs"
  },
  "dependencies": {
    "@jasy/decy": "^0.1.0",
    "@jasy/pdf": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.3"
  }
}
