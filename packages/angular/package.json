{
  "name": "@jasy/angular",
  "version": "1.0.0-beta.1",
  "description": "PDFs in Angular, the Angular way - a service, provideJasy() and a signal-based pdfResource() over the @jasy/pdf engine. Layout, pagination, fonts, forms; in the browser or on a server.",
  "keywords": [
    "angular",
    "browser",
    "declarative",
    "invoice",
    "jasy",
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "signals",
    "ssr"
  ],
  "license": "MIT",
  "author": "Florian Heuberger",
  "files": [
    "dist",
    "schematics",
    "!schematics/**/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.schematics.json",
    "prepack": "pnpm run build",
    "play": "tsc && cd playground && ng serve --open",
    "play:build": "tsc && cd playground && ng build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "~20.3.42",
    "@angular/build": "~20.3.42",
    "@angular/cli": "~20.3.42",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "~20.3.35",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@jasy/pdf": "workspace:*",
    "@schematics/angular": "~20.3.42",
    "@types/node": "^25.9.3",
    "rxjs": "^7.8.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@jasy/pdf": "workspace:^"
  },
  "ng-add": {
    "save": "dependencies"
  },
  "schematics": "./schematics/collection.json"
}
