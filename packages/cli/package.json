{
  "name": "@jasy/cli",
  "version": "1.0.0-beta.2",
  "description": "Validate, read and export ZUGFeRD and XRechnung e-invoices in the terminal: KoSIT EN 16931 rules and veraPDF, and nothing leaves your machine.",
  "keywords": [
    "cli",
    "e-invoice",
    "e-rechnung",
    "en16931",
    "factur-x",
    "kosit",
    "tui",
    "validator",
    "verapdf",
    "xrechnung",
    "zugferd"
  ],
  "license": "MIT",
  "author": "Florian Heuberger",
  "bin": {
    "jasy": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jano-editor/ui": "1.0.0-alpha.8",
    "@jasy/decy": "^0.1.0",
    "@jasy/e-invoice": "workspace:^",
    "@jasy/pdf": "workspace:^",
    "saxon-js": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.19.2",
    "xslt3": "^2.7.0"
  }
}
